{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "japanese-wiki",
  "compatibility_date": "2026-08-18",
  "main": "./worker.js",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "build": {
    "command": "npx quartz build",
    "cwd": ".",
    "output_dir": "./public"
  },
}
